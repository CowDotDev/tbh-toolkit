{
  "name": "tbh-toolkit",
  "version": "0.1.0",
  "description": "Local, read-only companion toolkit for TBH: Task Bar Hero - build share codes, game data browser, live XP/gold rates.",
  "main": "./out/main/index.js",
  "author": "CowDotDev",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/CowDotDev/tbh-toolkit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "node scripts/ensure-electron.mjs",
    "start": "electron-vite preview",
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepreview": "node scripts/ensure-electron.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "tsx --tsconfig tsconfig.node.json scripts/smoke.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
